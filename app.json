{
  "expo": {
    "name": "MOHANI",
    "slug": "mohani-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohani.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "add_expense",
            "UIApplicationShortcutItemTitle": "지출 추가",
            "UIApplicationShortcutItemSubtitle": "새 지출 기록하기",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAdd"
          },
          {
            "UIApplicationShortcutItemType": "view_today",
            "UIApplicationShortcutItemTitle": "오늘 지출",
            "UIApplicationShortcutItemSubtitle": "오늘 지출 현황 보기",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeDate"
          },
          {
            "UIApplicationShortcutItemType": "voice_input",
            "UIApplicationShortcutItemTitle": "음성 입력",
            "UIApplicationShortcutItemSubtitle": "음성으로 지출 기록",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAudio"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "package": "com.mohani.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "97acab6c-123d-4abb-9c83-9c3b1a3a7787"
      }
    }
  }
}
